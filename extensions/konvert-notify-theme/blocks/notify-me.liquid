{%- assign notify_variant = product.selected_variant | default: product.selected_or_first_available_variant -%}
<div
  id="konvert-notify"
  class="konvert-notify"
  data-konvert-notify
  hidden
  data-product-id="{{ product.id }}"
  data-endpoint="/apps/konvert-notify"
  data-analytics-endpoint="/apps/konvert-notify/analytics"
  data-product-name="{{ product.title | escape }}"
  data-initial-variant-id="{{ notify_variant.id }}"
  data-variants="{{ product.variants | json | escape }}"
  data-invalid-email="{{ 'notify_me.status.invalid_email' | t | escape }}"
  data-invalid-response="{{ 'notify_me.status.invalid_response' | t | escape }}"
  data-required-consent="{{ 'notify_me.status.required_consent' | t | escape }}"
  data-invalid-variant="{{ 'notify_me.status.invalid_variant' | t | escape }}"
  data-loading-message="{{ 'notify_me.status.loading' | t | escape }}"
  data-success-message="{{ 'notify_me.status.success' | t | escape }}"
  data-success-variant-message="{{ 'notify_me.status.success_variant' | t | escape }}"
  data-duplicate-message="{{ 'notify_me.status.duplicate' | t | escape }}"
  data-duplicate-variant-message="{{ 'notify_me.status.duplicate_variant' | t | escape }}"
  data-error-message="{{ 'notify_me.status.error' | t | escape }}"
  data-network-error="{{ 'notify_me.status.network_error' | t | escape }}"
  data-submitting-variant-message="{{ 'notify_me.status.submitting_variant' | t | escape }}"
  style="--konvert-notify-accent: {{ block.settings.accent_color }};"
  {{ block.shopify_attributes }}
>
  <button
    class="konvert-notify__trigger"
    type="button"
    data-open-dialog
    aria-haspopup="dialog"
    aria-controls="KonvertNotifyDialog-{{ block.id }}"
    hidden
  >
    {{ 'notify_me.open_button' | t }}
  </button>

  <dialog
    class="konvert-notify__dialog"
    id="KonvertNotifyDialog-{{ block.id }}"
    aria-labelledby="KonvertNotifyHeading-{{ block.id }}"
    data-dialog
  >
    <div class="konvert-notify__dialog-content">
      <button
        class="konvert-notify__close"
        type="button"
        data-close-dialog
        aria-label="{{ 'notify_me.close' | t | escape }}"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <h2
        class="konvert-notify__heading"
        id="KonvertNotifyHeading-{{ block.id }}"
      >
        {{ block.settings.heading | escape }}
      </h2>
      {% if block.settings.description != blank %}
        <p class="konvert-notify__description">
          {{ block.settings.description | escape }}
        </p>
      {% endif %}

      <dl class="konvert-notify__product">
        <div>
          <dt>{{ 'notify_me.product_label' | t }}</dt>
          <dd data-product-name>{{ product.title | escape }}</dd>
        </div>
        <div>
          <dt>{{ 'notify_me.variant_label' | t }}</dt>
          <dd data-variant-title>{{ notify_variant.title | escape }}</dd>
        </div>
      </dl>

      <form class="konvert-notify__form" data-form novalidate>
        <fieldset class="konvert-notify__channels">
          <legend class="konvert-notify__label">
            {{ 'notify_me.channel_label' | t }}
          </legend>
          <label class="konvert-notify__choice">
            <input
              type="radio"
              name="notify-channel-{{ block.id }}"
              value="EMAIL"
              checked
              required
            >
            <span>{{ 'notify_me.channel_email' | t }}</span>
          </label>
          <label class="konvert-notify__choice konvert-notify__choice--disabled">
            <input
              type="radio"
              name="notify-channel-{{ block.id }}"
              value="WHATSAPP"
              disabled
            >
            <span>{{ 'notify_me.channel_whatsapp' | t }}</span>
            <span class="konvert-notify__coming-soon">
              {{ 'notify_me.coming_soon' | t }}
            </span>
          </label>
        </fieldset>

        <div class="konvert-notify__field" data-email-field>
          <label
            class="konvert-notify__label"
            for="KonvertNotifyEmail-{{ block.id }}"
          >
            {{ 'notify_me.email_label' | t }}
          </label>
          <input
            class="konvert-notify__input"
            id="KonvertNotifyEmail-{{ block.id }}"
            name="contact"
            type="email"
            autocomplete="email"
            required
            maxlength="320"
            aria-describedby="KonvertNotifyStatus-{{ block.id }}"
            data-email
          >
        </div>

        <div class="konvert-notify__field konvert-notify__whatsapp" data-whatsapp-field>
          <label
            class="konvert-notify__label"
            for="KonvertNotifyCountryCode-{{ block.id }}"
          >
            {{ 'notify_me.phone_label' | t }}
          </label>
          <div class="konvert-notify__phone-inputs">
            <input
              class="konvert-notify__input konvert-notify__country-code"
              id="KonvertNotifyCountryCode-{{ block.id }}"
              type="text"
              disabled
              placeholder="{{ 'notify_me.country_code_placeholder' | t | escape }}"
              aria-label="{{ 'notify_me.country_code' | t | escape }}"
            >
            <input
              class="konvert-notify__input"
              type="tel"
              disabled
              placeholder="{{ 'notify_me.phone_placeholder' | t | escape }}"
              aria-label="{{ 'notify_me.phone_label' | t | escape }}"
            >
          </div>
        </div>

        <label class="konvert-notify__consent" for="KonvertNotifyConsent-{{ block.id }}">
          <input
            class="konvert-notify__checkbox"
            id="KonvertNotifyConsent-{{ block.id }}"
            name="consent"
            type="checkbox"
            required
            aria-describedby="KonvertNotifyStatus-{{ block.id }}"
            data-consent
          >
          <span>{{ 'notify_me.consent_label' | t }}</span>
        </label>

        <p
          class="konvert-notify__status"
          id="KonvertNotifyStatus-{{ block.id }}"
          data-status
          role="status"
          aria-live="polite"
        ></p>

        <div class="konvert-notify__actions">
          <button class="konvert-notify__submit" type="submit" data-submit>
            {{ block.settings.button_label | escape }}
          </button>
          <button
            class="konvert-notify__cancel"
            type="button"
            data-close-dialog
          >
            {{ 'notify_me.cancel' | t }}
          </button>
        </div>
      </form>
    </div>
  </dialog>
</div>

{{ 'notify-me.css' | asset_url | stylesheet_tag }}
<script src="{{ 'storefront-settings.js' | asset_url }}" defer></script>
<script src="{{ 'notify-me.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:notify_me.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:notify_me.settings.heading",
      "default": "Get notified when it's back"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:notify_me.settings.description",
      "default": "Enter your email and we'll let you know when this item is available."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:notify_me.settings.button_label",
      "default": "Notify me when available"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:notify_me.settings.accent_color",
      "default": "#1F2937"
    }
  ]
}
{% endschema %}
